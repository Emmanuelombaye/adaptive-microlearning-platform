# Copy this to .env and fill your real secrets. Do NOT commit real .env to git.

# MySQL
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=neuralearn
MYSQL_USER=neuralearn_user
MYSQL_PASSWORD=your_db_password

# App / Backend
DATABASE_URL=mysql+pymysql://neuralearn_user:your_db_password@db:3306/neuralearn
JWT_SECRET=replace_with_a_strong_random_secret

# Other
DOMAIN=yourdomain.com
