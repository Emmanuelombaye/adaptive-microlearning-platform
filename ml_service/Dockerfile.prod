# ML service multi-stage Dockerfile (production)
FROM python:3.10-slim AS builder

WORKDIR /ml_service
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

COPY ml_service/requirements.txt /ml_service/requirements.txt
RUN apt-get update && apt-get install -y build-essential --no-install-recommends && rm -rf /var/lib/apt/lists/*
RUN python -m pip install --upgrade pip
RUN pip install --no-cache-dir -r /ml_service/requirements.txt

FROM python:3.10-slim
WORKDIR /ml_service
COPY --from=builder /usr/local/lib/python3.10/site-packages /usr/local/lib/python3.10/site-packages
COPY ml_service /ml_service

EXPOSE 8001

CMD ["uvicorn", "api.ml_api:app", "--host", "0.0.0.0", "--port", "8001"]
